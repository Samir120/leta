{
  // Recommended when the workspace is opened. VS Code prompts to install them.
  "recommendations": [
    // C++ language server — diagnostics, formatting, navigation. Reads .clang-format/.clang-tidy.
    "llvm-vs-code-extensions.vscode-clangd",
    // CMake integration driven by CMakePresets.json
    "ms-vscode.cmake-tools",
    // CMake syntax highlighting
    "twxs.cmake",
    // Native debugger that works without ms-vscode.cpptools
    "vadimcn.vscode-lldb",
    // Honours .editorconfig
    "editorconfig.editorconfig",
    // YAML for .clang-format, .clang-tidy, CI workflows, the OpenAPI spec
    "redhat.vscode-yaml",
    // OpenAPI preview for docs/02-api-spec.yaml
    "42crunch.vscode-openapi",
    // GitHub Actions workflow authoring and run status
    "github.vscode-github-actions",
    // Markdown linting for docs/ and ADRs
    "davidanson.vscode-markdownlint",
    // Dockerfile support (M0-T7 onward)
    "ms-azuretools.vscode-docker"
  ],
  "unwantedRecommendations": []
}
