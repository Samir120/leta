# ---------------------------------------------------------------------------
# Build output — CMake + Ninja
# `build/` unanchored on purpose: the presets write to build/<preset>/ at the root,
# and any nested build/ is also junk.
# ---------------------------------------------------------------------------
build/
build-*/
/out/
_deps/
CMakeCache.txt
CMakeFiles/
CMakeUserPresets.json
cmake_install.cmake
compile_commands.json
install_manifest.txt
Testing/

# ---------------------------------------------------------------------------
# Working files that stay out of the public repository
# STATE.md and PROJECT_INSTRUCTIONS.md live in the Claude Project, not here.
# If a local copy is kept for reference, it is never committed.
# ---------------------------------------------------------------------------
/STATE.md
/PROJECT_INSTRUCTIONS.md

# ---------------------------------------------------------------------------
# Editors
# Nothing editor-specific is committed. Language-server behaviour that the whole
# project should share lives in the editor-agnostic .clangd file at the root.
# ---------------------------------------------------------------------------
# Vim / Neovim
*.swp
*.swo
*.swn
*~
Session.vim
.netrwhist
tags
TAGS
.exrc
.nvimrc
.nvim.lua

# Other editors' workspace state, in case a contributor uses one
.vscode/
.vscode-server/
.idea/
.DS_Store

# Language-server and indexer caches
.cache/
.ccls-cache/
.clangd/

# ---------------------------------------------------------------------------
# Sanitizer, fuzzer and coverage artefacts
# ---------------------------------------------------------------------------
*.gcda
*.gcno
*.profraw
*.profdata
coverage/
lcov.info
callgrind.out.*
perf.data
perf.data.old

# libFuzzer writes these into the working directory when it finds something.
# Those are transient. The SAME files, once copied into tests/fuzz/corpus/ as a
# regression case, ARE tracked — hence the re-include below.
crash-*
leak-*
oom-*
timeout-*
fuzz-*.log
!tests/fuzz/corpus/**

# ---------------------------------------------------------------------------
# Runtime data written by a local dev server
# Anchored to the repo root. An unanchored `data/` would also swallow
# tests/data/, which holds committed benchmark and relevance datasets.
# WAL and snapshot fixtures under tests/ are deliberately NOT excluded.
# ---------------------------------------------------------------------------
/data/

# ---------------------------------------------------------------------------
# Secrets and local overrides
# .env.example IS committed as documentation
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key

# ---------------------------------------------------------------------------
# Package manager caches Leta doesn't use itself, but that neighbours often do
# ---------------------------------------------------------------------------
node_modules/
__pycache__/
*.pyc
